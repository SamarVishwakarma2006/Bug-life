generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  DEVELOPER
  REVIEWER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugType {
  UI
  BACKEND
  DATABASE
  API
  PERFORMANCE
  SECURITY
  OTHER
}

enum BugStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  RESOLVED
  REOPENED
}

model User {
  id             String            @id @default(cuid())
  name           String
  email          String            @unique
  passwordHash   String
  tokenVersion   Int               @default(0)
  xp             Int               @default(0)
  level          Int               @default(1)
  currentStreak  Int               @default(0)
  longestStreak  Int               @default(0)
  lastResolvedAt DateTime?
  createdAt      DateTime          @default(now())
  ownedProjects  Project[]
  memberships    ProjectMember[]
  reportedBugs   Bug[]             @relation("Reporter")
  assignedBugs   Bug[]             @relation("Assignee")
  resolvedBugs   Bug[]             @relation("Resolver")
  comments       Comment[]
  activities     Activity[]
  attachments    Attachment[]
  notifications  Notification[]
  achievements   UserAchievement[]
  xpTransactions XPTransaction[]
}

model Project {
  id            String          @id @default(cuid())
  name          String
  key           String
  description   String          @default("")
  ownerId       String
  nextBugNumber Int             @default(1)
  createdAt     DateTime        @default(now())
  owner         User            @relation(fields: [ownerId], references: [id])
  members       ProjectMember[]
  bugs          Bug[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  role      Role    @default(DEVELOPER)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model Bug {
  id             String          @id @default(cuid())
  number         Int
  title          String
  description    String          @default("")
  priority       Priority        @default(MEDIUM)
  type           BugType         @default(OTHER)
  status         BugStatus       @default(BACKLOG)
  position       Float           @default(0)
  labels         String[]        @default([])
  dueDate        DateTime?
  reporterId     String
  assigneeId     String?
  projectId      String
  xpAwarded      Boolean         @default(false)
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  reporter       User            @relation("Reporter", fields: [reporterId], references: [id])
  assignee       User?           @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolvedBy     User?           @relation("Resolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments       Comment[]
  activities     Activity[]
  attachments    Attachment[]
  notifications  Notification[]
  xpTransactions XPTransaction[]

  @@unique([projectId, number])
  @@index([projectId, status, position])
  @@index([assigneeId])
}

model Comment {
  id        String   @id @default(cuid())
  bugId     String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([bugId, createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  bugId     String
  actorId   String
  type      String
  metadata  Json
  createdAt DateTime @default(now())
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([bugId, createdAt])
}

model Attachment {
  id           String   @id @default(cuid())
  bugId        String
  filename     String
  path         String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())
  bug          Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([bugId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  bugId     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug?     @relation(fields: [bugId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
}

model Achievement {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  description String
  icon        String
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model XPTransaction {
  id        String   @id @default(cuid())
  userId    String
  bugId     String
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
